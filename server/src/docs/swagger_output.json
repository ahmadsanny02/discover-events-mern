  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "Admin123"
          }
        },
        "xml": {
          "name": "LoginRequest"
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Administrator"
          },
          "username": {
            "type": "string",
            "example": "admin"
          },
          "email": {
            "type": "string",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "12345678"
          },
          "confirmPassword": {
            "type": "string",
            "example": "12345678"
          }
        },
        "xml": {
          "name": "RegisterRequest"
        }
      },
      "ActivationRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "abcde"
          }
        },
        "xml": {
          "name": "ActivationRequest"
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Technology"
          },
          "description": {
            "type": "string",
            "example": "Lorem ipsum dolor sit amet"
          }
        },
        "xml": {
          "name": "CreateCategoryRequest"
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "DevFest Bandung 2026"
          },
          "banner": {
            "type": "string",
            "example": "https://www.maranatha.edu/wp-content/uploads/2023/12/General-Banner-Digital-1.png"
          },
          "category": {
            "type": "string",
            "example": "6992ab95248f03936596e987"
          },
          "description": {
            "type": "string",
            "example": "Lorem ipsum dolor sit amet"
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-10 10:00:00"
          },
          "endDate": {
            "type": "string",
            "example": "2026-10-10 22:00:00"
          },
          "location": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "example": "3204"
              },
              "coordinates": {
                "type": "array",
                "example": [
                  6.6,
                  10.1
                ],
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "isOnline": {
            "type": "boolean",
            "example": false
          },
          "isFeatured": {
            "type": "boolean",
            "example": true
          }
        },
        "xml": {
          "name": "CreateEventRequest"
        }
      },
      "RemoveMediaRequest": {
        "type": "object",
        "properties": {
          "fileUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/dxhd77rfp/image/upload/v1781055529/spgik1o55kvmztj2b76g.jpg"
          }
        },
        "xml": {
          "name": "RemoveMediaRequest"
        }
      },
      "CreateBannerRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Banner - DevFest Bandung 2026"
          },
          "image": {
            "type": "string",
            "example": "https://res.cloudinary.com/dxhd77rfp/image/upload/v1794962608/ddpzxnrjm6yww2qergtw.jpg"
          },
          "isShow": {
            "type": "boolean",
            "example": true
          }
        },
        "xml": {
          "name": "CreateBannerRequest"
        }
      },
      "CreateTicketRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ticket Reguler"
          },
          "price": {
            "type": "string",
            "example": "2000"
          },
          "events": {
            "type": "string",
            "example": "6acdd8aed8f87cad10a8213b"
          },
